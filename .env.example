# Copy to .env (gitignored) and fill in. Dev defaults below work out of the box.

# ---- Postgres ----
POSTGRES_DB=timeline
POSTGRES_USER=timeline
POSTGRES_PASSWORD=timeline
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Database URL (parsed by django-environ) ----
DATABASE_URL=postgres://timeline:timeline@db:5432/timeline

# ---- Django ----
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Dev: the Vite dev server origin (proxy usually makes this moot, but the
# browsable API / direct :8000 calls benefit from it).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prod only (TLS behind nginx): set to your real https origin(s).
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False

# ---- Static collection (entrypoint) ----
# 0 in dev (runserver serves static), 1 in prod.
RUN_COLLECTSTATIC=0

# ---- Frontend (dev container) ----
VITE_PROXY_TARGET=http://backend:8000
