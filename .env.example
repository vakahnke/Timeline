# Copy to .env (gitignored) and fill in. Dev defaults below work out of the box.

# ---- Postgres ----
POSTGRES_DB=timeline
POSTGRES_USER=timeline
POSTGRES_PASSWORD=timeline
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Database URL (parsed by django-environ) ----
DATABASE_URL=postgres://timeline:timeline@db:5432/timeline

# ---- Django ----
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Dev: the Vite dev server origin (proxy usually makes this moot, but the
# browsable API / direct :8000 calls benefit from it).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prod only (TLS behind nginx): set to your real https origin(s).
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False

# ---- Static collection (entrypoint) ----
# 0 in dev (runserver serves static), 1 in prod.
RUN_COLLECTSTATIC=0

# ---- Email & account approval ----
# New sign-ups stay INACTIVE until you approve them in Django admin. Set to 0 to
# let accounts sign in immediately (no approval).
REQUIRE_ACCOUNT_APPROVAL=1
# How far people may share their saved templates: instance (default), teams, or off.
# TEMPLATE_LIBRARY=instance
# Gmail SMTP. Leave EMAIL_HOST_USER empty in dev -> emails print to the backend logs.
# In prod, set EMAIL_HOST_USER + EMAIL_HOST_PASSWORD and real mail is sent automatically.
# Use an App Password (Google account needs 2-Step Verification):
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# "From" on outgoing mail (defaults to EMAIL_HOST_USER):
DEFAULT_FROM_EMAIL=
# Where new-account alerts are sent (defaults to ADMIN_NOTIFY_EMAIL if you set that instead):
ACCOUNT_NOTIFY_EMAIL=
# Public app URL used for links inside account emails (sign-in / admin):
SITE_URL=http://localhost:5173

# ---- Frontend (dev container) ----
VITE_PROXY_TARGET=http://backend:8000

# ---- Production (docker-compose.prod.yml) — see docs/AWS_DEPLOYMENT.md ----
# DOMAIN=timeline.example.com
# CERTBOT_EMAIL=you@example.com
# WEB_CONCURRENCY=3                 # gunicorn workers; tune to the instance (≈ 2*vCPU+1, memory-bound)
# BACKUP_KEEP_DAYS=14               # for deploy/backup-db.sh
# S3_BACKUP_BUCKET=                 # optional: copy DB backups off-box
#
# For production also set (in .env):
#   DJANGO_DEBUG=0
#   DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(64))">
#   POSTGRES_PASSWORD=<strong>      (and DATABASE_URL to match)
#   DJANGO_ALLOWED_HOSTS=timeline.example.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://timeline.example.com
#   DJANGO_CORS_ALLOWED_ORIGINS=    (empty — same origin in prod)
#   DJANGO_SECURE_SSL_REDIRECT=False (nginx already redirects 80→443)
#   RUN_COLLECTSTATIC=1
#   SITE_URL=https://timeline.example.com
#   ACCOUNT_NOTIFY_EMAIL=you@gmail.com   (new-account alerts come here)
#   EMAIL_HOST_USER=you@gmail.com        (the Gmail account)
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
